---
import KnowledgeGraph from "@components/widget/KnowledgeGraph.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getKnowledgeGraphData } from "@/utils/reference-graph-server";
import "@/styles/reference/categories.css";
import "@/styles/reference/knowledge-graph.css";
import "@/styles/reference/graph-dock.css";
import "@/styles/reference/graph-detail-panel.css";
import { getCategoryUrl, url } from "@/utils/url-utils";

// 只取 meta（几百字节）内联；节点与边走 /api/knowledge-graph.json
const { meta } = await getKnowledgeGraphData();

const title = i18n(I18nKey.categories);
const description = "通过分类、标签与关系图谱浏览本站文章。";
---

<MainGridLayout title={title} description={description}>
  <Fragment slot="head">
    {/* 解析 HTML 时就并发拉图数据，抵消独立端点多出的那次往返 */}
    <link rel="prefetch" href={url("/api/knowledge-graph.json")} as="fetch" crossorigin="anonymous" />
  </Fragment>

  <div class="graph-page">
    <KnowledgeGraph meta={meta} />
  </div>
  <nav class="reference-graph-links" aria-label={title}>
    <h2>{i18n(I18nKey.categories)}</h2>
    <ul>
      {meta.categories.map((category) => (
        <li><a href={getCategoryUrl(category.name)}>{category.name} <small>{category.postCount}</small></a></li>
      ))}
    </ul>
  </nav>
</MainGridLayout>
