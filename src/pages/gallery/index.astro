---
import { Icon } from "astro-icon/components";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/reference/album.css";
import { scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.gallery) return Astro.redirect("/404/");

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);
const albums = galleryConfig.albums.map((album) => ({
	...album,
	photos: album.password ? [] : scanAlbumPhotos(album.id),
}));
const tags = [...new Set(albums.flatMap((album) => album.tags ?? []))].sort();
const getAlbumSearch = (album: (typeof albums)[number]) =>
	[album.name, album.description, album.location, ...(album.tags ?? [])].filter(Boolean).join(" ").toLocaleLowerCase();
---

<MainGridLayout title={title} description={description}>
	<album-wall class="block">
		<div class="alb-bar">
			<div class="alb-bar__row">
				<label class="alb-search">
					<Icon name="material-symbols:search-rounded" aria-hidden="true" />
					<input type="search" placeholder="搜索照片 / 相册 / 地点…" aria-label="搜索照片或相册" />
				</label>
				<span class="alb-count" data-album-count aria-live="polite">{albums.length} 个相册</span>
			</div>
			<div class="alb-bar__row alb-bar__row--tabs">
				<div class="alb-tabs" role="group" aria-label="按相册筛选">
					<button class="alb-tab is-active" type="button" data-album-id="" aria-pressed="true">全部</button>
					{albums.map((album) => (
						<button class="alb-tab" type="button" data-album-id={album.id} aria-pressed="false">
							{album.password && <Icon name="material-symbols:lock-outline" class="mr-1 inline" aria-hidden="true" />}{album.name}
						</button>
					))}
				</div>
				{tags.length > 0 && <div class="alb-tabs alb-tabs--tags" role="group" aria-label="按标签筛选">
					<span class="alb-tabs__label">标签</span>
					{tags.map((tag) => <button type="button" class="alb-tab" data-album-tag={tag} aria-pressed="false">{tag}</button>)}
				</div>}
			</div>
		</div>
		<div class="alb-wall">
			{albums.flatMap((album) => album.photos.map((src, index) => (
				<a class="alb-photo" href={src} data-no-swup data-fancybox="album-wall" data-photo-album={album.id} data-photo-search={`${getAlbumSearch(album)} ${src.split("/").pop()?.toLocaleLowerCase() ?? ""}`} data-album-tags={JSON.stringify(album.tags ?? [])}>
					<img src={src} alt={`${album.name} · ${index + 1}`} loading="lazy" decoding="async" />
				</a>
			)))}
		</div>
		<p class="py-8 text-center text-(--content-meta)" data-no-album hidden>没有符合条件的内容</p>
		<nav class="mt-5 flex flex-wrap gap-2 text-sm" aria-label="打开相册">
			{albums.map((album) => (
				<a class="rounded-full border border-(--line-divider) px-3 py-1.5 hover:bg-(--btn-plain-bg-hover)" href={url(`/gallery/${album.id}/`)} data-album-link={album.id} data-photo-search={getAlbumSearch(album)} data-album-tags={JSON.stringify(album.tags ?? [])}>
					{album.password && <Icon name="material-symbols:lock-outline" class="mr-1 inline" aria-hidden="true" />}{album.name} <span aria-hidden="true">↗</span>
				</a>
			))}
		</nav>
	</album-wall>
</MainGridLayout>

<script>
	class AlbumWall extends HTMLElement {
		private album = "";
		private tag = "";
		private controller?: AbortController;

		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const { signal } = this.controller;
			const search = this.querySelector<HTMLInputElement>("input[type=search]");
			const count = this.querySelector("[data-album-count]");
			const empty = this.querySelector<HTMLElement>("[data-no-album]");
			const buttons = [...this.querySelectorAll<HTMLButtonElement>(".alb-tab")];
			const photos = [...this.querySelectorAll<HTMLAnchorElement>("[data-photo-album]")];
			const links = [...this.querySelectorAll<HTMLAnchorElement>("[data-album-link]")];
			const apply = () => {
				const query = search?.value.trim().toLocaleLowerCase() || "";
				const matches = (element: HTMLElement, albumId: string | undefined) =>
					(!this.album || this.album === albumId) &&
					(!query || Boolean(element.dataset.photoSearch?.includes(query))) &&
					(!this.tag || (JSON.parse(element.dataset.albumTags ?? "[]") as string[]).includes(this.tag));
				const foundAlbums = new Set<string>();
				for (const photo of photos) {
					const match = matches(photo, photo.dataset.photoAlbum);
					photo.hidden = !match;
					photo.classList.toggle("is-hide", !match);
					if (match && photo.dataset.photoAlbum) foundAlbums.add(photo.dataset.photoAlbum);
					if (match) photo.dataset.fancybox = "album-wall";
					else delete photo.dataset.fancybox;
				}
				for (const link of links) {
					const id = link.dataset.albumLink;
					const match = matches(link, id) || Boolean(id && foundAlbums.has(id));
					link.hidden = !match;
					if (match && id) foundAlbums.add(id);
				}
				for (const button of buttons) {
					const active = button.dataset.albumId === this.album || button.dataset.albumTag === this.tag;
					button.classList.toggle("is-active", active);
					button.setAttribute("aria-pressed", String(active));
				}
				if (count) count.textContent = `${foundAlbums.size} 个相册`;
				if (empty) empty.hidden = foundAlbums.size !== 0;
			};
			search?.addEventListener("input", apply, { signal });
			this.addEventListener("click", (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const button = target.closest<HTMLButtonElement>(".alb-tab");
				if (!button) return;
				if (button.dataset.albumId !== undefined) this.album = button.dataset.albumId;
				if (button.dataset.albumTag !== undefined) this.tag = this.tag === button.dataset.albumTag ? "" : button.dataset.albumTag;
				apply();
			}, { signal });
			apply();
		}

		disconnectedCallback() {
			this.controller?.abort();
		}
	}

	if (!customElements.get("album-wall")) customElements.define("album-wall", AlbumWall);
</script>
