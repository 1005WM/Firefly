---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { backgroundWallpaper, profileConfig } from "@/config";

interface Props { title: string }
const { title } = Astro.props;
const source = backgroundWallpaper.src;
const desktop = typeof source === "string" || Array.isArray(source) ? source : source.desktop;
const cover = Array.isArray(desktop) ? desktop[0] : desktop;
const { avatar, name, bio } = profileConfig;
---
<div class="wx-cover">
  <!-- 封面图 -->
  <div class="wx-cover-img-box">
    {cover && <ImageWrapper src={cover} alt="" class="wx-cover-img" widths={[480, 960, 1440]} sizes="(min-width: 1280px) 70vw, 100vw" loading="eager" fadeIn={false} showOverlay={false} />}
  </div>

  <!-- 个人信息栏（封面图下方） -->
  <div class="wx-info-bar">
    <!-- 头像：右侧，向上突出盖住封面图 -->
    <div class="wx-avatar-box">
      {avatar && <ImageWrapper src={avatar} alt="" class="wx-avatar" widths={[160]} sizes="80px" loading="eager" fadeIn={false} showOverlay={false} />}
    </div>
    <!-- 昵称：头像左边，在封面图上 -->
    <h1 class="wx-name"><span class="sr-only">{title} · </span>{name}</h1>
    <!-- 签名：右侧，头像下方 -->
    {bio && <div class="wx-bio">{bio}</div>}
  </div>
</div>

<style>
  .wx-cover {
    margin-bottom: 1.25rem;
    border-radius: 12px;
    overflow: visible;
    position: relative;
  }

  /* ===== 封面图 ===== */
  .wx-cover-img-box {
    width: 100%;
    height: 280px;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
  }

  .wx-cover-img-box :global(.wx-cover-img), .wx-cover-img-box :global(.wx-cover-img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
    display: block;
  }

  .wx-cover:hover .wx-cover-img-box :global(.wx-cover-img), .wx-cover-img-box :global(.wx-cover-img img) {
    transform: scale(1.02);
  }

  /* ===== 个人信息栏 ===== */
  .wx-info-bar {
    position: relative;
    background: var(--card-bg);
    border: none;
    border-radius: 0 0 12px 12px;
    padding: 0.75rem 1.25rem 1rem;
    min-height: 2rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  /* 签名：右侧，头像下方 */
  .wx-bio {
    font-size: 0.8125rem;
    color: var(--content-meta);
    line-height: 1.5;
    text-align: right;
    max-width: calc(100% - 8rem);
    margin-left: auto;
    margin-top: 2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 头像：右侧，向上突出 */
  .wx-avatar-box {
    position: absolute;
    top: 0;
    right: 1.25rem;
    transform: translateY(-65%);
    z-index: 20;
  }

  .wx-avatar-box :global(.wx-avatar) {
    width: 5rem;
    height: 5rem;
    border-radius: 6px;
    object-fit: cover;
    border: 3px solid var(--page-bg);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
    display: block;
  }

  .wx-avatar-box :global(.wx-avatar picture),
  .wx-avatar-box :global(.wx-avatar img) {
    width: 100%;
    height: 100%;
  }

  /* 昵称：头像左边，在封面图上（绝对定位在封面图底部） */
  .wx-name {
    position: absolute;
    right: 7rem;
    top: 0;
    transform: translateY(-110%);
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
    z-index: 15;
  }

  /* ===== 响应式 ===== */
  @media (max-width: 480px) {
    .wx-cover-img-box {
      height: 200px;
      border-radius: 8px 8px 0 0;
    }

    .wx-cover {
      border-radius: 8px;
    }

    .wx-info-bar {
      border-radius: 0 0 8px 8px;
      padding: 0.625rem 1rem 0.75rem;
    }

    .wx-avatar-box :global(.wx-avatar) {
      width: 4rem;
      height: 4rem;
    }

    .wx-avatar-box {
      right: 1rem;
    }

    .wx-name {
      right: 5.75rem;
      font-size: 1.0625rem;
    }

    .wx-bio {
      font-size: 0.75rem;
    }
  }
</style>
