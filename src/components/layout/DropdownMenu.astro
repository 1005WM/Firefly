---
import { Icon } from "astro-icon/components";
import type { NavBarLink } from "@/types/config";
import { isNavigationRoute, normalizeNavigationPath } from "@/utils/reference-navigation";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	menuId: string;
}

const { link, menuId } = Astro.props;
const hasChildren = Boolean(link.children?.length);
const routes = (hasChildren ? link.children ?? [] : [link])
	.filter((item) => !item.external && item.url !== "#")
	.map((item) => new URL(url(item.url), Astro.url).pathname);
const currentPath = normalizeNavigationPath(Astro.url.pathname);
const active = routes.some((route) => isNavigationRoute(route, currentPath));
---

<div data-dropdown data-nav-routes={JSON.stringify(routes)} data-nav-active={active ? "" : undefined}>
	{hasChildren ? (
		<button
			type="button"
			class="reference-nav-trigger"
			aria-expanded="false"
			aria-controls={menuId}
			data-dropdown-trigger
		>
			{link.icon && <Icon name={link.icon} class="reference-nav-icon" />}
			{link.name}
			<Icon name="material-symbols:keyboard-arrow-down-rounded" class="reference-nav-arrow" aria-hidden="true" />
		</button>
		<div id={menuId} class="reference-nav-popup" data-dropdown-menu inert>
			<div class="reference-nav-panel">
				{link.children?.map((child) => (
					<a
						href={child.external ? child.url : url(child.url)}
						target={child.external ? "_blank" : undefined}
						rel={child.external ? "noopener noreferrer" : undefined}
						aria-current={!child.external && normalizeNavigationPath(new URL(url(child.url), Astro.url).pathname) === currentPath ? "page" : undefined}
						class="reference-nav-option"
					>
						{child.icon && <Icon name={child.icon} class="reference-nav-icon" />}
						<span>{child.name}</span>
						{child.external && (
							<Icon name="fa7-solid:arrow-up-right-from-square" class="reference-nav-external" aria-hidden="true" />
						)}
					</a>
				))}
			</div>
		</div>
	) : (
		<a
			aria-current={routes.some((route) => normalizeNavigationPath(route) === currentPath) ? "page" : undefined}
			href={link.external ? link.url : url(link.url)}
			target={link.external ? "_blank" : undefined}
			rel={link.external ? "noopener noreferrer" : undefined}
			class="reference-nav-trigger"
		>
			{link.icon && <Icon name={link.icon} class="reference-nav-icon" />}
			{link.name}
			{link.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="reference-nav-external" aria-hidden="true" />}
		</a>
	)}
</div>
